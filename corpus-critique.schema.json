{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jlov7/damn-vulnerable-agent-asset-corpus/main/corpus-critique.schema.json",
  "title": "DVAAC Corpus Critique Report",
  "type": "object",
  "required": [
    "corpus_id",
    "critique_format_version",
    "target",
    "reviewer",
    "scope",
    "findings",
    "public_reproducibility",
    "claim_boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "corpus_id": {
      "const": "dvaac"
    },
    "critique_format_version": {
      "const": "0.1"
    },
    "target": {
      "type": "object",
      "required": [
        "dvaac_release",
        "dvaac_release_commit",
        "dvaac_doi",
        "aac_verifier_release",
        "aac_verifier_commit"
      ],
      "additionalProperties": false,
      "properties": {
        "dvaac_release": {
          "const": "v0.1.5"
        },
        "dvaac_release_commit": {
          "const": "e90a76daf9107871d1ff6a2d7c438d2b92709e53"
        },
        "dvaac_doi": {
          "const": "10.5281/zenodo.20379817"
        },
        "aac_verifier_release": {
          "const": "v0.2-candidate.8"
        },
        "aac_verifier_commit": {
          "const": "936885583a49dfd06fd11ce45c8ee82330f1007d"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["name", "affiliation_or_project", "contact", "reviewed_at"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "affiliation_or_project": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "review_type",
        "fixture_ids",
        "files_reviewed",
        "commands_run",
        "environment",
        "corpus_conformance_result"
      ],
      "additionalProperties": false,
      "properties": {
        "review_type": {
          "enum": [
            "fixture-realism",
            "expected-findings",
            "taxonomy",
            "safety",
            "scorecard-format",
            "release-process",
            "documentation",
            "other"
          ]
        },
        "fixture_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "files_reviewed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "commands_run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "environment": {
          "type": "string"
        },
        "corpus_conformance_result": {
          "enum": ["not-run", "pass", "fail"]
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "severity",
          "category",
          "subject",
          "title",
          "description",
          "evidence",
          "recommendation",
          "suggested_change_type"
        ],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^DVAAC-CRITIQUE-[A-Z0-9-]+$"
          },
          "severity": {
            "enum": ["info", "low", "medium", "high"]
          },
          "category": {
            "enum": [
              "fixture-realism",
              "expected-findings",
              "taxonomy",
              "safety",
              "scorecard-format",
              "release-process",
              "documentation",
              "reproducibility",
              "other"
            ]
          },
          "subject": {
            "type": "object",
            "required": ["type", "ref"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": ["fixture", "corpus", "schema", "docs", "runner", "release-process"]
              },
              "ref": {
                "type": "string"
              }
            }
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "suggested_change_type": {
            "enum": ["none", "docs", "fixture", "schema", "runner", "release-process", "security-report"]
          }
        }
      }
    },
    "public_reproducibility": {
      "type": "object",
      "required": ["can_summarize_publicly", "redactions", "reproduction_notes"],
      "additionalProperties": false,
      "properties": {
        "can_summarize_publicly": {
          "type": "boolean"
        },
        "redactions": {
          "type": "string"
        },
        "reproduction_notes": {
          "type": "string"
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "scanner_validation_claimed",
        "corpus_correctness_claimed",
        "endorsement_claimed"
      ],
      "additionalProperties": false,
      "properties": {
        "scanner_validation_claimed": {
          "const": false
        },
        "corpus_correctness_claimed": {
          "const": false
        },
        "endorsement_claimed": {
          "const": false
        }
      }
    }
  }
}
